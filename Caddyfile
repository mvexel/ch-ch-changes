{
    email your-email@example.com
    admin off
}

# Replace with your actual domain
# For testing with IP address only, use:
# http://5.161.255.103 {
#     reverse_proxy api:3000
# }

changesets.yourdomain.com {
    reverse_proxy api:3000

    encode gzip zstd

    log {
        output file /var/log/caddy/access.log
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }
}

# Docker registry (public with auth)
registry.osm.lol {
    # Generate hash: caddy hash-password --plaintext 'your-password'
    basicauth {
        registry_user REPLACE_WITH_HASH
    }

    reverse_proxy registry:5000

    log {
        output file /var/log/caddy/registry-access.log
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }
}
