# AWS Ephemeral Processing Configuration
# Copy this to /opt/changeset-app/aws-config.env on your VPS

# AWS Configuration
AWS_REGION=us-east-1

# EC2 Instance Configuration
INSTANCE_TYPE=c6i.4xlarge  # 16 vCPU, 32GB RAM (~$0.34/hr spot)
# Other good options:
#   c6i.2xlarge  - 8 vCPU, 16GB  (~$0.17/hr spot)
#   c6i.8xlarge  - 32 vCPU, 64GB (~$0.68/hr spot)

# Ubuntu 22.04 AMI IDs by region
# us-east-1: ami-0c55b159cbfafe1f0
# us-west-2: ami-0ceecbb0f30a902a6
# eu-west-1: ami-0d71ea30463e0ff8d
AMI_ID=ami-0c55b159cbfafe1f0

# Networking (REQUIRED - set these for your VPC)
SECURITY_GROUP=sg-xxxxxxxxxxxxx  # Must allow SSH (port 22) from your VPS IP
SUBNET_ID=subnet-xxxxxxxxxxxxx   # Must have public IP auto-assign enabled

# SSH Key (REQUIRED)
KEY_NAME=changeset-processor         # Name of your AWS key pair
SSH_KEY_PATH=~/.ssh/aws-processor.pem  # Path to private key on VPS

# Spot pricing
SPOT_PRICE=0.50  # Maximum price you're willing to pay per hour

# Image registry
IMAGE_REGISTRY=registry.osm.lol  # Or your Tailscale IP if building locally

# Local storage
DEST_DATA_DIR=/opt/changeset-data/changesets
