# AWS Ephemeral Processing Configuration
# Copy this to /opt/changeset-app/aws-config.env on your VPS

# AWS Configuration
AWS_REGION=us-east-1

# EC2 Instance Configuration
INSTANCE_TYPE=c6i.4xlarge  # 16 vCPU, 32GB RAM (~$0.34/hr spot)
# Other good options:
#   c6i.2xlarge  - 8 vCPU, 16GB  (~$0.17/hr spot)
#   c6i.8xlarge  - 32 vCPU, 64GB (~$0.68/hr spot)

# Ubuntu 24.04 LTS AMI (should match region)
AMI_ID=ami-0ecb62995f68bb549

# Networking
# If you used the default names below, you can leave SECURITY_GROUP and SUBNET_ID empty.
SECURITY_GROUP_NAME=changeset-processor-sg  # Group name created in docs/AWS.md
SECURITY_GROUP=sg-xxxxxxxxxxxxx             # Optional override (must allow SSH from VPS IP)
SUBNET_ID=subnet-xxxxxxxxxxxxx              # Optional override (public IP auto-assign enabled)

# SSH Key (REQUIRED)
KEY_NAME=changeset-processor          # Name of your AWS key pair
SSH_KEY_PATH=~/.ssh/aws-processor.pem  # Path to private key on VPS

# Local paths
REPO_DIR=/opt/changeset-app           # Path to repository on VPS
DEST_DATA_DIR=/opt/changeset-data/changesets  # Where to store processed data
