# Shared environment for systemd services
# Keep secrets here; file should be readable by the service user only.

# API server
OSM_OAUTH_CLIENT_ID=""
OSM_OAUTH_CLIENT_SECRET=""
OSM_OAUTH_REDIRECT_URL="http://127.0.0.1:3000/auth/osm/callback"
AUTH_KEY_SECRET=""
AUTH_DB_PATH="/var/lib/chch/auth.db"
AUTH_DEFAULT_DAILY_LIMIT=0
AUTH_DEFAULT_MONTHLY_LIMIT=0
REQUIRE_AUTH=true
DATA_PATH="/opt/chch/data/changesets"

# Replication worker
POLL_INTERVAL_SECONDS=60
CHANGESET_REPLICATION_URL="https://planet.openstreetmap.org/replication/changesets/"
HOME="/var/lib/chch"
ENABLE_COMPACTION=true
COMPACTION_AGE_HOURS=24
