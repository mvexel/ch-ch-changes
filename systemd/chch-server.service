[Unit]
Description=ch-ch-changes OSM Changeset API Server
Documentation=https://codeberg.org/mvexel/ch-ch-changes
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=chch
Group=chch
WorkingDirectory=/opt/chch

# Environment variables
Environment="DATA_PATH=/opt/chch/data"
Environment="RUST_LOG=info"
Environment="HOME=/var/lib/chch"
Environment="AUTH_DB_PATH=/var/lib/chch/auth.sqlite"
Environment="AUTH_KEY_SECRET=YOUR_STRONG_SECRET_HERE"
Environment="OSM_OAUTH_CLIENT_ID=YOUR_CLIENT_ID_HERE"
Environment="OSM_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE"
Environment="OSM_OAUTH_REDIRECT_URL=https://chch.osm.lol/auth/osm/callback"
Environment="AUTH_DEFAULT_DAILY_LIMIT=0"
Environment="AUTH_DEFAULT_MONTHLY_LIMIT=0"

# Binary location
ExecStart=/opt/chch/bin/chch-server

# Restart policy - crucial for automatic recovery from failures
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chch/data /var/lib/chch

# Resource limits
LimitNOFILE=65536
MemoryMax=4G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chch-server

[Install]
WantedBy=multi-user.target
