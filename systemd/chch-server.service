[Unit]
Description=ch-ch-changes OSM Changeset API Server
Documentation=https://codeberg.org/mvexel/ch-ch-changes
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=chch
Group=chch
WorkingDirectory=/opt/chch

# Environment variables
EnvironmentFile=-/opt/chch/.env

# Binary location
ExecStart=/opt/chch/bin/chch-server

# Restart policy - crucial for automatic recovery from failures
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chch/data /var/lib/chch

# Resource limits
LimitNOFILE=65536
MemoryMax=4G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chch-server

[Install]
WantedBy=multi-user.target
