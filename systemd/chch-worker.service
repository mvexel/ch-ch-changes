[Unit]
Description=ch-ch-changes OSM Changeset Replication Worker
Documentation=https://codeberg.org/mvexel/ch-ch-changes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chch
Group=chch
WorkingDirectory=/opt/chch

# Environment variables
EnvironmentFile=-/opt/chch/.env

# Binary location
ExecStart=/opt/chch/bin/chch-worker

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chch/data /var/lib/chch

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chch-worker

[Install]
WantedBy=multi-user.target
