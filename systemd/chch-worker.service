[Unit]
Description=ch-ch-changes OSM Changeset Replication Worker
Documentation=https://codeberg.org/mvexel/ch-ch-changes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chch
Group=chch
WorkingDirectory=/opt/chch

# Environment variables
Environment="DATA_PATH=/opt/chch/data/changesets"
Environment="POLL_INTERVAL_SECONDS=60"
Environment="CHANGESET_REPLICATION_URL=https://planet.openstreetmap.org/replication/changesets/"
Environment="HOME=/var/lib/chch"

# Compaction settings (optional - disabled by default)
# Enable to automatically compact old delta files into single files per month
Environment="ENABLE_COMPACTION=true"
# Hours to wait before compacting files (default: 24 = compact yesterday's data)
Environment="COMPACTION_AGE_HOURS=24"

# Binary location
ExecStart=/opt/chch/bin/chch-worker

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chch/data /var/lib/chch

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chch-worker

[Install]
WantedBy=multi-user.target
