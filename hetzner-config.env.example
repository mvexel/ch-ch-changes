# Hetzner Cloud Configuration for Ephemeral Changeset Processing
# Copy this file to /opt/changeset-app/hetzner-config.env and configure

# Required: Your Hetzner Cloud API token
# Get it from: https://console.hetzner.cloud/ → Project → Security → API Tokens
HETZNER_TOKEN=your_token_here

# Server configuration
SERVER_TYPE=ccx33           # 8 vCPU, 32GB RAM (~€0.045/hour)
LOCATION=nbg1               # Nuremberg (alternatives: fsn1, hel1, ash)
IMAGE=ubuntu-22.04

# SSH Key name (must exist in your Hetzner project)
SSH_KEY_NAME=changeset-processor

# Local paths
DEST_DATA_DIR=/opt/changeset-data/changesets
REPO_DIR=/opt/changeset-app
LOG_FILE=/var/log/changeset-hetzner-$(date +%Y%m%d-%H%M%S).log

# Server type options:
# - ccx23: 4 vCPU, 16GB RAM, ~€0.023/hour (smaller workloads)
# - ccx33: 8 vCPU, 32GB RAM, ~€0.045/hour (recommended)
# - ccx43: 16 vCPU, 64GB RAM, ~€0.090/hour (large workloads)
# - ccx53: 32 vCPU, 128GB RAM, ~€0.180/hour (very large workloads)
