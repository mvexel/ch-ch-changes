your.domain {
      # Proxy all API and changeset requests to Rust server
      handle /changesets/* {
          reverse_proxy localhost:3000
      }

      handle /changeset/* {
          reverse_proxy localhost:3000
      }

      handle /meta/* {
          reverse_proxy localhost:3000
      }

      handle /health {
          reverse_proxy localhost:3000
      }

      handle /auth/* {
          reverse_proxy localhost:3000
      }

      # Static files and SPA fallback
      handle {
          root * /opt/changeset-app/static
          templates
          try_files {path} /index.html
          file_server
      }
}
