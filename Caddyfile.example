# Example Caddyfile for ch-ch-changes

# Simple setup: reverse proxy everything to FastAPI server
# FastAPI serves both API endpoints and static landing page
chch.osm.lol {
    reverse_proxy localhost:3000

    # Optional: enable gzip compression
    encode gzip

    # Optional: logging
    log {
        output file /var/log/caddy/chch.log
    }
}

# Alternative: with custom headers and rate limiting
chch-advanced.osm.lol {
    # Reverse proxy to FastAPI
    reverse_proxy localhost:3000 {
        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 5s

        # Custom headers
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compression
    encode gzip zstd

    # Rate limiting (requires caddy-ratelimit plugin)
    # rate_limit {
    #     zone api {
    #         key {remote_host}
    #         rate 100r/m
    #     }
    # }

    # Logging
    log {
        output file /var/log/caddy/chch.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

# Development setup (HTTP only, no TLS)
:3001 {
    reverse_proxy localhost:3000
}
