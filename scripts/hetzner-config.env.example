# Copy this file to hetzner-config.env and edit

# Hetzner API token. Get it from: https://console.hetzner.cloud/ → Project → Security → API Tokens
HETZNER_TOKEN=your_token_here
# Hetzner SSH Key name, create or upload one at https://console.hetzner.cloud/ → Project → Security → SSH Keys
SSH_KEY_NAME=changeset-processor

# Ephemeral server configuration
SERVER_TYPE=ccx33           # 8 vCPU, 32GB RAM (~€0.045/hour)
LOCATION=nbg1               # Nuremberg (alternatives: fsn1, hel1, ash)
IMAGE=ubuntu-22.04

# Local paths
DEST_DATA_DIR=/opt/changeset-data/changesets
REPO_DIR=/opt/changeset-app
LOG_FILE=/var/log/changeset-hetzner-$(date +%Y%m%d-%H%M%S).log
